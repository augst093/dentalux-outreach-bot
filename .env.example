# Copy this file to .env for local runs only. On Railway, set these in the service Variables tab.
# Never put real values in this file or in git. Fill in names only as shown below.

# Telegram token of the APPROVAL bot (created in @BotFather). Not the DentaLux clinic bot.
BOT_TOKEN=

# Your numeric Telegram user id (get it from @userinfobot). Only this user can use the bot.
ADMIN_USER_ID=

# PostgreSQL on Railway: ${{Postgres.DATABASE_URL}}. Locally you can leave it empty (uses SQLite).
DATABASE_URL=

# Optional. Without it the bot uses built-in templates.
ANTHROPIC_API_KEY=
# Optional. Default: claude-sonnet-5-5
ANTHROPIC_MODEL=

# Optional. Default: 10
DAILY_SEND_LIMIT=
# Optional. Default: 180 (minimum pause between approvals, in seconds)
SEND_PAUSE_SECONDS=
# Optional. Default: Asia/Tashkent (day boundary for the daily limit)
TIMEZONE=

# Webhook mode (Railway): https://<your-service>.up.railway.app with no trailing slash
PUBLIC_WEBHOOK_URL=
# Random string, 1-256 characters: letters, digits, _ and -. Telegram sends it back on every request.
WEBHOOK_SECRET=

# Local testing only: 1 = long polling when PUBLIC_WEBHOOK_URL is empty. Never set this on Railway.
ALLOW_POLLING=

# Set by Railway automatically. Locally, optional. Default: 8080
PORT=
